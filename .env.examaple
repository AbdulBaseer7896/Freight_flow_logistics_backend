SECRET_KEY=django-insecure-xybx0+lz5qpz-btys!@cbzpm#p*ar-^#+#&bw8_g!jdb$25_(@

# Environment: 'development' | 'production'
ENVIRONMENT=production
DEBUG=False
ALLOWED_HOSTS=*

# CORS — comma-separated list of allowed frontend origins.
# Leave empty (or unset) to allow all origins in development.
# In production you MUST set this.
CORS_ALLOWED_ORIGINS=https://app.freightflow.com,https://admin.freightflow.com

# PostgreSQL — only used when ENVIRONMENT=production
# -------------------------------------------------------
# Option 1 (preferred): full connection string
DATABASE_URL=postgres://user:password@localhost:5432/freight_db

# Option 2: explicit individual credentials (used if DATABASE_URL is not set)
DB_NAME=freight_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
